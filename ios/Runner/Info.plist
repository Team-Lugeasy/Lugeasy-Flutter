			<string>com.lugeasy.jimjim</string>
			</array>
		</dict>
		<!-- Google 로그인 -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
			<string>com.googleusercontent.apps.378524376717-dnrbpvluv5svj1t56kkt3knm4kqvhfpn</string>
			</array>
		</dict>
	</array>
